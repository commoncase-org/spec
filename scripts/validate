#!/usr/bin/env python3
"""Validate conformance/vectors.json against the commoncase rendering rules,
cross-check every referenced decision record actually exists, and verify
data registries (transliteration table, core lexicon).
"""
import csv
import json
import sys
from pathlib import Path

ROOT = Path(__file__).resolve().parent.parent
VECTORS_PATH = ROOT / "conformance" / "vectors.json"
CASES_PATH = VECTORS_PATH
DECISIONS_DIR = ROOT / "decisions"
LEXICON_PATH = ROOT / "data" / "lexicon.json"
CSV_PATH = ROOT / "data" / "transliteration.csv"


def cap(tok):
    return tok[0].upper() + tok[1:] if tok else tok


def pascal(tokens):
    return "".join(cap(t) for t in tokens)


def camel(tokens):
    if not tokens:
        return ""
    first = tokens[0]
    first = first[0].lower() + first[1:] if first else first
    return first + "".join(cap(t) for t in tokens[1:])


def snake(tokens):
    return "_".join(tokens)


def kebab(tokens):
    return "-".join(tokens)


def constant(tokens):
    return "_".join(t.upper() for t in tokens)


RULES = {
    "pascal": pascal,
    "camel": camel,
    "snake": snake,
    "kebab": kebab,
    "constant": constant,
}


def main():
    errors = []

    cases = json.loads(CASES_PATH.read_text(encoding="utf-8"))

    # (a) recompute five outputs per entry
    for entry in cases:
        cid = entry.get("id", "?")
        tokens = entry["tokens"]
        for style, fn in RULES.items():
            expected = fn(tokens)
            actual = entry[style]
            if expected != actual:
                errors.append(
                    f"case {cid} ({entry.get('input')!r}): {style} "
                    f"mismatch — expected {expected!r}, got {actual!r}"
                )

    # (b) confirm every decision slug resolves to a real file
    decision_files = {p.stem for p in DECISIONS_DIR.glob("*.md")}
    for entry in cases:
        cid = entry.get("id", "?")
        decision = entry.get("decision")
        if decision is None:
            continue
        if decision not in decision_files:
            errors.append(
                f"case {cid} ({entry.get('input')!r}): decision slug "
                f"{decision!r} has no matching file in decisions/"
            )

    # (c) validate data/lexicon.json schema
    if not LEXICON_PATH.exists():
        errors.append(f"missing registry file: {LEXICON_PATH}")
    else:
        try:
            lexicon = json.loads(LEXICON_PATH.read_text(encoding="utf-8"))
            if not isinstance(lexicon, list):
                errors.append("data/lexicon.json must be a JSON array")
            else:
                for idx, item in enumerate(lexicon):
                    if not isinstance(item.get("key"), str) or not item["key"]:
                        errors.append(f"lexicon[{idx}]: missing or invalid 'key'")
                    if not isinstance(item.get("tokens"), list) or not item["tokens"]:
                        errors.append(f"lexicon[{idx}]: missing or invalid 'tokens'")
                    if not isinstance(item.get("rationale"), str) or not item["rationale"]:
                        errors.append(f"lexicon[{idx}]: missing or invalid 'rationale'")
        except Exception as ex:
            errors.append(f"failed to parse data/lexicon.json: {ex}")

    # (d) validate data/transliteration.csv
    if not CSV_PATH.exists():
        errors.append(f"missing registry file: {CSV_PATH}")
    else:
        try:
            with CSV_PATH.open(encoding="utf-8") as f:
                reader = csv.DictReader(f)
                fieldnames = set(reader.fieldnames or [])
                if not {"codepoint", "character", "name"}.issubset(fieldnames) or not (
                    "ascii_replacement" in fieldnames or "replacement" in fieldnames
                ):
                    errors.append("data/transliteration.csv missing required columns")
        except Exception as ex:
            errors.append(f"failed to read data/transliteration.csv: {ex}")

    if errors:
        print(f"FAIL — {len(errors)} error(s):")
        for e in errors:
            print(f"  - {e}")
        return 1

    print(
        f"OK — {len(cases)} conformance vectors validated, all decision links resolve, "
        "and data registries are verified."
    )
    return 0


if __name__ == "__main__":
    sys.exit(main())
