#!/usr/bin/env python3
"""Scaffold a new decision record from decisions/0000-template.md.

Usage:
    scripts/create-decision <Title of the decision>

Finds the next free decision number, slugifies the title into a
filename, and writes decisions/<NNNN>-<slug>.md with the id and title
already filled in from the template.
"""
import re
import sys
from pathlib import Path

ROOT = Path(__file__).resolve().parent.parent
DECISIONS_DIR = ROOT / "decisions"
TEMPLATE_PATH = DECISIONS_DIR / "0000-template.md"

ID_RE = re.compile(r"^(\d{4})-.+\.md$")


def next_id():
    highest = 0
    for path in DECISIONS_DIR.glob("*.md"):
        if path.name == "0000-template.md":
            continue
        m = ID_RE.match(path.name)
        if m:
            highest = max(highest, int(m.group(1)))
    return highest + 1


def slugify(title):
    slug = title.strip().lower()
    slug = re.sub(r"[^a-z0-9]+", "-", slug)
    return slug.strip("-")


def main():
    if len(sys.argv) < 2:
        print("usage: scripts/create-decision <Title of the decision>", file=sys.stderr)
        return 1

    title = " ".join(sys.argv[1:]).strip()
    if not title:
        print("error: title must not be empty", file=sys.stderr)
        return 1

    if not TEMPLATE_PATH.exists():
        print(f"error: template not found at {TEMPLATE_PATH}", file=sys.stderr)
        return 1

    new_id = f"{next_id():04d}"
    slug = slugify(title)
    if not slug:
        print(f"error: title {title!r} produced an empty slug", file=sys.stderr)
        return 1

    dest = DECISIONS_DIR / f"{new_id}-{slug}.md"
    if dest.exists():
        print(f"error: {dest} already exists", file=sys.stderr)
        return 1

    content = TEMPLATE_PATH.read_text(encoding="utf-8")
    content = content.replace('id: "0000"', f'id: "{new_id}"')
    content = content.replace('title: "<Title>"', f'title: "{title}"')

    dest.write_text(content, encoding="utf-8")
    print(f"created {dest.relative_to(ROOT)}")
    return 0


if __name__ == "__main__":
    sys.exit(main())
